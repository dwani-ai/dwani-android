<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/whatsapp_background">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/whatsapp_green">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/voice_assistant_title"
            app:titleTextColor="#FFFFFF"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable transcript/reply; bottom padding clears FAB + bottom nav -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="220dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hintText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/voice_assistant_hint"
                android:textSize="16sp"
                android:textColor="#333333"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/voice_assistant_status_idle"
                android:textSize="15sp"
                android:textColor="@color/whatsapp_green"
                android:textStyle="bold"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/voice_assistant_label_transcript"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="#555555"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/transcriptText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:textSize="15sp"
                android:textColor="#222222"
                android:lineSpacingMultiplier="1.15"
                tools:text="Transcript appears here" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/voice_assistant_label_reply"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="#555555"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/replyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:textSize="15sp"
                android:textColor="#222222"
                android:lineSpacingMultiplier="1.15"
                tools:text="Assistant reply" />

            <ProgressBar
                android:id="@+id/audioLevelBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="24dp"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/whatsapp_green"
                android:background="#D0C8B8" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/voice_assistant_mic_hint"
                android:textSize="13sp"
                android:textColor="#666666" />

            <ProgressBar
                android:id="@+id/pipelineProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                android:indeterminate="true" />

            <ProgressBar
                android:id="@+id/ttsProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"
                android:visibility="gone"
                android:indeterminate="true" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Above bottom nav: not inside weighted layout so it stays full size -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/holdToTalkFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="@dimen/voice_assistant_fab_margin_bottom"
        android:contentDescription="@string/voice_assistant_hold_content_description"
        android:src="@drawable/ic_mic"
        app:fabCustomSize="80dp"
        app:maxImageSize="40dp"
        app:elevation="8dp"
        app:pressedTranslationZ="12dp"
        app:tint="@android:color/white"
        app:backgroundTint="@color/whatsapp_green" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/whatsapp_input_background"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/whatsapp_green"
        app:itemTextColor="@color/whatsapp_green"
        app:labelVisibilityMode="labeled" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
